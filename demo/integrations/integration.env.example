# Copy this file to .env in this directory. The initialization script creates
# a stronger version automatically; never commit the generated file.
FLEET_MYSQL_ROOT_PASSWORD=replace-me
FLEET_MYSQL_PASSWORD=replace-me
FLEET_SERVER_PRIVATE_KEY=replace-me
FLEET_IMAGE=fleetdm/fleet:v4.90.0

NETBOX_DB_PASSWORD=replace-me
NETBOX_REDIS_PASSWORD=replace-me
NETBOX_REDIS_CACHE_PASSWORD=replace-me
NETBOX_SECRET_KEY=replace-me
NETBOX_API_TOKEN_PEPPER=replace-me
NETBOX_SUPERUSER_API_KEY=demo
NETBOX_SUPERUSER_API_TOKEN=replace-me
NETBOX_SUPERUSER_PASSWORD=replace-me
NETBOX_IMAGE=docker.io/netboxcommunity/netbox:v4.6.9-5.0.2
