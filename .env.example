# ─── Required secrets ───
SECRET_KEY=__generate_with_openssl_rand_hex_32__
JWT_SECRET=__generate_with_openssl_rand_hex_32__
ENCRYPTION_KEY=__generate_with_openssl_rand_hex_32__
POSTGRES_PASSWORD=__strong_random_password__
REDIS_PASSWORD=__strong_random_password__
ANTHROPIC_API_KEY=

# Local AI (Docker Desktop reaches Ollama on the Windows host via host.docker.internal)
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11434
AI_API_KEY=ollama
AI_MODEL=qwen3:14b
AI_TIMEOUT_SEC=180
AI_CONTEXT_LENGTH=8192
AI_THINKING=false

# ─── Optional ───
NVD_API_KEY=
EPSS_BASE_URL=https://api.first.org/data/v1/epss
OSV_BASE_URL=https://api.osv.dev/v1/query
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=kepryx@example.com
PAGERDUTY_KEY=

# Host ports. Use 80/443 on a real deployment; local Windows testing can use 8083/8443.
HTTP_PORT=80
HTTPS_PORT=443

# ─── App ───
ENVIRONMENT=production
DEBUG=false
POSTGRES_DB=kepryx
POSTGRES_USER=kepryx
CORS_ORIGINS=["https://kepryx.local"]
ALLOWED_HOSTS=["kepryx.local","localhost","127.0.0.1"]
TRUSTED_PROXY_CIDRS=["172.29.0.2/32"]
# Restrict admin and other privileged management operations to approved client CIDRs.
# Replace the local Docker defaults for a real deployment.
MANAGEMENT_CIDRS=["127.0.0.1/32","::1/128","172.29.0.0/24"]
# Permit private connector IP literals only when their network is explicitly authorized.
CONNECTOR_ALLOWED_CIDRS=[]
REDIS_URL=redis://:__strong_random_password__@redis:6379/0
# Empty by default. Add only CIDRs for which you have explicit scan authorization.
SCAN_NETWORKS=[]
MAX_SCAN_HOSTS=4096

# Destructive retention is disabled until an approved policy is configured.
RETENTION_DELETE_ENABLED=false
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_ARCHIVE_DAYS=365
INACTIVE_ASSET_DAYS=90
INACTIVE_USER_FLAG_DAYS=365
