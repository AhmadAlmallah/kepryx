FROM python:3.14-alpine@sha256:05b2b8b732ecd268fee8727a369f936f022d1321b59befd13c30ede22769dcdc

LABEL org.opencontainers.image.title="Kepryx Asset Source Mock" \
      org.opencontainers.image.authors="Ahmad Almallah <ahmad.almallah.consulting@hotmail.com>" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates && \
    addgroup -S -g 10001 kepryx && \
    adduser -S -D -H -s /sbin/nologin -G kepryx -u 10001 kepryx
WORKDIR /app
COPY --chown=10001:10001 demo/ ./demo/
USER 10001:10001
EXPOSE 8766

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8766/health', timeout=2).read()"]

CMD ["python", "-m", "demo.asset_source_mock.server", "--host", "0.0.0.0", "--port", "8766"]
