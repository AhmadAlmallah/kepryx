FROM postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2

LABEL org.opencontainers.image.title="Kepryx PostgreSQL" \
      org.opencontainers.image.authors="Ahmad Almallah <ahmad.almallah.consulting@hotmail.com>" \
      org.opencontainers.image.licenses="Apache-2.0"

# The official entrypoint only needs gosu when started as root. Kepryx starts
# PostgreSQL as uid 70, so remove the vulnerable privilege-switching binary.
USER root
RUN apk upgrade --no-cache && rm -f /usr/local/bin/gosu
USER 70:70
