FROM python:3.12-alpine@sha256:d09d15e60962ca365d1cd544a48773bac9d33f2fb1b00f2aa0deec78ade7dc31

LABEL org.opencontainers.image.title="Kepryx Isolated Demo Target" \
      org.opencontainers.image.authors="Ahmad Almallah <ahmad.almallah.consulting@hotmail.com>" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

RUN apk upgrade --no-cache && \
    addgroup -S -g 10001 kepryx && \
    adduser -S -D -H -s /sbin/nologin -G kepryx -u 10001 kepryx
WORKDIR /app
COPY --chown=10001:10001 demo/ ./demo/
USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/', timeout=2).read()"]

# Explicit container-network listener; Compose publishes no host ports for this target.
CMD ["python", "-m", "demo.virtual_target.server", "--host", "0.0.0.0"]
